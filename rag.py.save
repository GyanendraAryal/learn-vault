


rt os

from dotenv import load_dotenv
from groq import Groq
from sentence_transformers import SentenceTransformer
from qdrant_client import QdrantClient

# loading enviornment variables
load_dotenv()

api_key = os.getenv("GROQ_API_KEY")

if not api_key:
    raise ValueError("API key kaha hai bhai")

client = Groq(api_key=api_key)
model = "openai/gpt-oss-120b"
embedding_model = SentenceTransformer(
    "sentence-transformers/all-MiniLM-L6-v2",
)
qdrant_client = QdrantClient(path="qdrant_storage")

COLLECTION_NAME = "learn_vault"


def retrieve_chunks(question, limit=5):

    question_vector = embedding_model.encode(
        question, normalize_embeddings=True
    ).tolist()

    results = qdrant_client.query_points(
        collection_name=COLLECTION_NAME,
        query=question_vector,
        limit=limit,
        with_payload=True,
    ).points
    return results


def generate_answer(question):
    chunks = retrieve_chunks(question)

    # Experimental threshold; tune it using test questions.
    MIN_SCORE = 0.45

    chunks = [chunk for chunk in chunks if chunk.score >= MIN_SCORE]
    if not chunks:
        print(
            "I couldn't find sufficiently relevant course material "
            "to answer confidently."
        )
        return

    context_parts = []

    for index, chunk in enumerate(chunks, start=1):
        payload = chunk.payload or {}

        context_parts.append(
            f"Source {index}\n"
            f"Video ID: {payload.get('video_id', 'Unknown')}\n"
            f"Timestamp: {payload.get('start', 0):.1f}s - "
            f"{payload.get('end', 0):.1f}s\n"
            f"Transcript: {payload.get('text', '')}"
        )

    # Combine all retrieved chunks into one context
    context = "\n\n".join(context_parts)

    response = client.chat.completions.create(
        model=model,
        messages=[
            {
                "role": "system",
                "content": (
                    "You are Learn Vault, an assistant for learning Django "
                    "from recorded course lectures.\n\n"
                    "RULES:\n"
                    "1. Use the retrieved transcript context as your primary "
                    "source of information.\n"
                    "2. Do not claim that the instructor said something unless "
                    "the provided context supports that claim.\n"
                    "3. If the context is insufficient or unclear, explicitly "
                    "say that the course transcripts do not provide enough "
                    "reliable information.\n"
                    "4. Transcripts may contain speech-recognition errors. "
                    "Do not invent missing words or treat garbled text as fact.\n"
                    "5. You may explain general Django concepts to clarify an "
                    "answer, but clearly distinguish general knowledge from "
                    "information supported by the transcripts.\n"
                    "6. Explain concepts in simple language, using examples "
                    "when useful.\n"
                    "7. Never invent video IDs, timestamps, quotations, or "
                    "other source details.\n\n"
                    "Structure your response with a direct answer, a short "
                    "explanation, and any important limitations."
                ),
            },
            {
                "role": "user",
                "content": (
                    f"Question: {question}\n\n" f"Retrieved course context:\n{context}"
                ),
            },
        ],
        temperature=0.2,
        max_tokens=800,
    )

    print("\n" + "=" * 60)
    print("ANSWER")
    print("=" * 60)
    print(response.choices[0].message.content)

    print("\n" + "=" * 60)
    print("SOURCES")
    print("=" * 60)

    for index, chunk in enumerate(chunks, start=1):
        payload = chunk.payload or {}

        print(
            f"{index}. Video: {payload.get('video_id', 'Unknown')} | "
            f"{payload.get('start', 0):.1f}s - "
            f"{payload.get('end', 0):.1f}s | "
            f"Score: {chunk.score:.4f}"
        )


if __name__ == "__main__":
    try:
        while True:
            question = input("\nAsk a Django question (or type 'exit'): ").strip()

            if question.lower() in {"exit", "quit"}:
                break

            if question:
                generate_answer(question)

    finally:
        qdrant_client.close()
